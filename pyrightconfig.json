{
  "venvPath": ".",
  "venv": ".venv",
  "extraPaths": [
    "packages/everalgo-core/src",
    "packages/everalgo-boundary/src",
    "packages/everalgo-clustering/src",
    "packages/everalgo-rank/src",
    "packages/everalgo-parser/src",
    "packages/everalgo-user-memory/src",
    "packages/everalgo-agent-memory/src",
    "packages/everalgo-knowledge/src"
  ],
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "tests"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.ruff_cache",
    "**/.mypy_cache",
    ".venv"
  ],
  "pythonVersion": "3.12"
}
