.env
results/*
!results/.gitkeep

# Whitelist the canonical reference run committed for reviewers.
# 2026-06-02 full LoCoMo run, main branch, 93.05% majority-vote / 92.92% mean-of-runs (1433/1540).
# Only the top-level summary (report.txt / report.json + profile.json) and the
# reproduction note (REPRODUCTION.md) are committed. Everything else stays
# gitignored — re-run from source to regenerate (eval_results.json + stage 1-4 outputs).
!results/locomo-93.05
results/locomo-93.05/*
!results/locomo-93.05/report.txt
!results/locomo-93.05/report.json
!results/locomo-93.05/profile.json
!results/locomo-93.05/REPRODUCTION.md

__pycache__/
*.pyc
.pytest_cache/
datasets/*/data/*.json
!datasets/*/data/.gitkeep
