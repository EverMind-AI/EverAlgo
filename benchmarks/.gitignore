.env
results/*
!results/.gitkeep

# Whitelist the canonical reference run committed for reviewers.
# 2026-05-27 full LoCoMo run, tag v6-2-92.55, agentic retrieval, 92.55% (1425/1540).
# Only the top-level summary (report.txt / report.json + profile.json) and the
# reproduction note (REPRODUCTION.md) are committed. Everything else stays
# gitignored — re-run from source to regenerate (eval_results.json + stage 1-4 outputs).
!results/locomo-92.55
results/locomo-92.55/*
!results/locomo-92.55/report.txt
!results/locomo-92.55/report.json
!results/locomo-92.55/profile.json
!results/locomo-92.55/REPRODUCTION.md

__pycache__/
*.pyc
.pytest_cache/
datasets/*/data/*.json
!datasets/*/data/.gitkeep
